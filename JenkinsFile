pipeline {

    agent any

    stages {

        stage('global stage') {

            agent {
                docker {
                    image 'usebruno/cli:latest'
                    args '-u root --entrypoint='
                }
            }

            stages {

                stage('Clean Allure Results') {

                    steps {
                        sh '''
                            echo "Suppression du cache Allure..."
                            rm -rf allure-results
                            mkdir -p allure-results
                            echo "Dossier allure-results nettoyé avec succès"
                        '''
                    }
                }

                stage('Run Bruno Tests') {

                    steps {
                        sh '''
                            echo "Lancement des tests Bruno..."

                            bru run \
                              --env-file environments/preprod.yml \
                              --reporter-junit allure-results/Test-results.xml

                            echo "Tests Bruno terminés."
                        '''
                    }
                }
            }
        }
    }

    post {

        always {

            echo 'Archivage des résultats Allure...'

            archiveArtifacts(
                artifacts: 'allure-results/*',
                allowEmptyArchive: true
            )

            allure(
                includeProperties: false,
                jdk: '',
                results: [
                    [path: 'allure-results/']
                ]
            )
        }
    }
}